{
  "name": "salt-matcher",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist --d1 DB=salt-matcher-db",
    "d1:init": "wrangler d1 execute salt-matcher-db --local --file=./schema.sql && wrangler d1 execute salt-matcher-db --local --file=./seed.sql",
    "d1:init:remote": "wrangler d1 execute salt-matcher-db --remote --file=./schema.sql && wrangler d1 execute salt-matcher-db --remote --file=./seed.sql"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "vite": "^6.2.0",
    "wrangler": "^3.111.0"
  }
}
